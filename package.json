{
  "name": "legends-poker",
  "version": "1.0.0",
  "description": "Legends Poker: Death's Invitational -- a character-driven Texas Hold'em tour.",
  "main": "index.js",
  "scripts": {
    "sim": "tsx src/sim.ts",
    "play": "tsx src/play.ts",
    "tourney": "tsx src/tourney.ts",
    "check:pots": "tsx src/pot-conservation.ts",
    "check:hands": "tsx src/hand-check.ts",
    "check:data": "tsx src/data-check.ts",
    "check:replay": "tsx src/replay-check.ts",
    "check:loki": "tsx src/loki-check.ts",
    "roster": "tsx src/roster.ts",
    "reads": "tsx src/reads.ts",
    "headsup": "tsx src/headsup.ts",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm run check:data && npm run check:pots && npm run check:hands && npm run check:replay && npm run check:loki",
    "build:web": "node web/build.mjs",
    "web": "node web/build.mjs && node web/serve.mjs",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "poker-ts": "^1.5.0",
    "pokersolver": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
